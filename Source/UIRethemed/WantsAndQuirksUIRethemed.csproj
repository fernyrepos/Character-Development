<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI Rethemed look. Loaded only with UI Rethemed - Core (LoadFolders.xml), so it may reference Core; the main assembly never does. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>WantsAndQuirksUIRethemed</RootNamespace>
    <AssemblyName>WantsAndQuirksUIRethemed</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- UI Rethemed - Core's Workshop folder; override with -p:UIRethemedCoreDir=... or UIRETHEMED_CORE_DIR. -->
    <UIRethemedCoreDir Condition="'$(UIRethemedCoreDir)' == ''">$(UIRETHEMED_CORE_DIR)</UIRethemedCoreDir>
    <UIRethemedCoreDir Condition="'$(UIRethemedCoreDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3832843406</UIRethemedCoreDir>
  </PropertyGroup>

  <!-- RimWorld 1.6 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <OutputPath>..\..\1.6\Mods\UIRethemedCore\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
    <UIRethemedCoreDll>$(UIRethemedCoreDir)\Versions\1.6\Assemblies\UIRethemedCore.dll</UIRethemedCoreDll>
  </PropertyGroup>

  <!-- RimWorld 1.7 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>..\..\1.7\Mods\UIRethemedCore\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <UIRethemedCoreDll>$(UIRethemedCoreDir)\Versions\1.7\Assemblies\UIRethemedCore.dll</UIRethemedCoreDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.*" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" />
    <PackageReference Include="Lib.Harmony" Version="2.*">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5014-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.7">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WantsAndQuirks.csproj" Private="false" />
    <Reference Include="UIRethemedCore">
      <HintPath>$(UIRethemedCoreDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <Target Name="UIRethemedCoreVerifyReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(UIRethemedCoreDll)')"
           Text="UIRethemedCore.dll not found at '$(UIRethemedCoreDll)'. Subscribe to UI Rethemed - Core (Workshop 3832843406), set UIRETHEMED_CORE_DIR, or pass -p:UIRethemedCoreDir=..." />
  </Target>

</Project>
